DATABASE_URL="file:./dev.db"

# Integration Gateway Mode:
# - "MOCK": Pre-Integration instant simulation (default when live keys are not yet set)
# - "LIVE" (or "FLUTTERWAVE"): Live API integration with Paystack & Flutterwave
GATEWAY_MODE="MOCK"

# Public URL of the deployed application (used for live payment callbacks & webhooks)
NEXT_PUBLIC_APP_URL="https://money-manager-production-6fbe.up.railway.app"

# Preferred Wallet Funding Provider in LIVE mode: "AUTO" | "PAYSTACK" | "FLUTTERWAVE"
WALLET_FUNDING_PROVIDER="AUTO"

# Paystack Live / Test Credentials (for Multi-Channel Customer Wallet Funding: Bank Transfer, Card, USSD)
PAYSTACK_PUBLIC_KEY="pk_test_mock_db_capital"
PAYSTACK_SECRET_KEY="sk_test_mock_db_capital"
PAYSTACK_WEBHOOK_SECRET="whsec_paystack_mock_db_capital"

# Flutterwave Live / Test Credentials (for Wallet Funding, Virtual/Physical Smart Cards & Standing Order Repayments)
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-mock-key-db-capital"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-mock-key-db-capital"
FLUTTERWAVE_ENCRYPTION_KEY="FLWSECK_TEST-mock-enc"
FLUTTERWAVE_WEBHOOK_SECRET="whsec_flw_mock_db_capital"
